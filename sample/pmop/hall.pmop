-- hall.pmop
-- ===============================================================
-- Hall の結婚定理 (Marriage theorem, 1935)
-- ===============================================================
--
-- 主張 (一般形):
--   二部グラフ G = (A, B, E) について、A の各頂点を異なる B の頂点に
--   割り当てる「完全マッチング (matching saturating A)」が存在する
--   ことの必要十分条件は、Hall 条件
--
--      ∀ S ⊆ A, |N(S)| ≥ |S|
--
--   が成り立つことである。ここで N(S) = ⋃_{a ∈ S} {b ∈ B | (a,b) ∈ E}。
--
--   直感: 「どんな k 人の男性を選んでも、彼ら全員から見て『結婚可能な
--          女性』の人数が少なくとも k 人居る」⇔ 全員一斉に異なる
--          相手とマッチング可能。
--
-- 既知の小さい例:
--   |A| = |B| = 2:
--     E = {(a₁,b₁), (a₂,b₂)}        → Hall 成立、マッチング {(a₁,b₁),(a₂,b₂)}
--     E = {(a₁,b₁), (a₂,b₁)}        → Hall 違反 ({a₁,a₂} の隣接が {b₁} 1 人だけ)
--                                       マッチング不存在
--     E = {(a₁,b₁), (a₁,b₂), (a₂,b₁), (a₂,b₂)} → Hall 成立、マッチング 2 通り
--
--   |A| = |B| = 3 (本ファイル):
--     たとえば「a₁ は b₁ のみ、a₂ は b₁、a₃ は b₃ のみ受容」だと
--     Hall 違反 (S = {a₁, a₂} の隣接 = {b₁} だけで |S| = 2 > 1)。
--     マッチング不可能。
--
-- 本ファイルで形式化するのは |A| = |B| = 3 のケース (Hall(3)):
--
--   ∀ G : Multiset (Fin 3 × Fin 3),
--     hall_condition_3 G →
--     ∃ (b₁ g₁) (b₂ g₂) (b₃ g₃),
--       {b₁, b₂, b₃} = {0, 1, 2} ∧ {g₁, g₂, g₃} 互いに異なる ∧
--       (bᵢ, gᵢ) ∈ G  for i = 1, 2, 3
--
-- ===============================================================
-- pattern-match-oriented で書くと
-- ===============================================================
--
-- 辺集合 G を multiset (Fin 3 × Fin 3) として観察する。
-- 「マッチング」= boy 側と girl 側それぞれで重複しない辺の取り出し:
--
--   matches
--     ($b₁, $g₁) ::
--     ($b₂ & !#b₁, $g₂ & !#g₁) ::
--     ($b₃ & !#b₁ & !#b₂, $g₃ & !#g₁ & !#g₂) ::
--     _
--   as multiset (Fin 3 × Fin 3)
--
-- 読み下し:
--   - 1 辺目: 任意の (b₁, g₁) を取る
--   - 2 辺目: b₂ は b₁ と異なり、g₂ は g₁ と異なる別の辺
--   - 3 辺目: b₃ は b₁, b₂ と異なり、g₃ は g₁, g₂ と異なる別の辺
--   - 残り: 問わない
--
-- これで 3 辺がそれぞれ distinct な (boy, girl) を持つマッチングを
-- 取り出している。!# パターン (否定 value pattern) が distinctness の
-- 表現を担うのが Hall の定式化のポイント。
-- pwl-ramsey.md で Ramsey の反対色三角形が `!#c & $c'` で表現されて
-- いるのと同じ仕掛け。
--
-- Lean 4 / Mathlib で同じことを書くと、Finset.exists_injective_of_card_eq
-- + Hall 定理本体 + マッチングの存在を ⟨b₁, g₁, ...⟩ で構成、と
-- 数式と命題ロジックの往復が必要になる。

import prelude

-- ---------------------------------------------------------------
-- Hall 条件 (n = 3 用に explicit に列挙)
-- ---------------------------------------------------------------
-- |Fin 3| = 3 なので部分集合は 2^3 = 8 個。空集合を除いた
-- 7 個 (1 要素 3 つ、2 要素 3 つ、3 要素 1 つ) について
-- N(S) のサイズ条件を書く。

def neighbors_3
    (G : Multiset (Fin 3 × Fin 3)) (S : Multiset (Fin 3))
    : Multiset (Fin 3)
  := primitive  -- 後で multiset comprehension で実装
  -- ⚠ 実装上の注意: 返り値は重複を除いた台集合 (support) でなければ
  -- ならない。G の重複辺をそのまま数えると Hall 条件が誤って成立する:
  --   G = ⟦(0,0), (0,0), (1,0), (2,2)⟧ では N({0,1}) の素朴サイズは
  --   3 ≥ 2 となるが、実際の隣接 girl は {0} のみで、boys 0, 1 を
  --   distinct な girl にマッチさせることはできず、hall_3 が偽になる。
  -- (design/review.md §4)

def size_3 {A : Type} (xs : Multiset A) : Nat := primitive

def hall_condition_3 (G : Multiset (Fin 3 × Fin 3)) : Type :=
    -- 単一要素 S: |N({b})| ≥ 1
    (size_3 (neighbors_3 G ⟦0⟧) ≥ 1)
  × (size_3 (neighbors_3 G ⟦1⟧) ≥ 1)
  × (size_3 (neighbors_3 G ⟦2⟧) ≥ 1)
    -- 2 要素 S: |N({b,b'})| ≥ 2
  × (size_3 (neighbors_3 G ⟦0, 1⟧) ≥ 2)
  × (size_3 (neighbors_3 G ⟦0, 2⟧) ≥ 2)
  × (size_3 (neighbors_3 G ⟦1, 2⟧) ≥ 2)
    -- 3 要素 S: |N({0,1,2})| ≥ 3
  × (size_3 (neighbors_3 G ⟦0, 1, 2⟧) ≥ 3)

-- ⟦...⟧ は multiset リテラル表記 (Egison/Lean 風)。
-- パーサで {x, y, ...} と区別するために ⟦⟧ を専用にする。

-- ---------------------------------------------------------------
-- 主定理: Hall(3)
-- ---------------------------------------------------------------

theorem hall_3
    (G : Multiset (Fin 3 × Fin 3))
    (hall : hall_condition_3 G)
    matches
      ($b1, $g1) ::
      ($b2 & !#b1, $g2 & !#g1) ::
      ($b3 & !#b1 & !#b2, $g3 & !#g1 & !#g2) ::
      _
    as multiset (Fin 3 × Fin 3)
  := by
  -- 古典的証明 (Hall 1935, 帰納法):
  --   case 1 (タイト): ある空でない真部分集合 S ⊂ Boys で |N(S)| = |S|。
  --     S と N(S) に制限したサブグラフは Hall を満たすので帰納仮定で
  --     マッチング M₁ が取れる。残り Boys \ S を Girls \ N(S) に
  --     マッチングするサブグラフは Hall 条件を継承するので M₂ が取れる。
  --     M₁ ∪ M₂ が求める完全マッチング。
  --   case 2 (ゆとり): 全ての空でない真部分集合 S で |N(S)| > |S|。
  --     任意の Boy a を任意の隣接 Girl b に割り当てて残りに帰納。
  --     ゆとりがあるので残り Hall 条件が保たれる。
  --
  -- pattern-match-oriented での閉じ方:
  --   Multiset (Fin 3 × Fin 3) は重複度に上限がないため、G 全体を
  --   有限個の入力として全数検査することはできない。
  --   Hall 条件は台集合 (重複を除いた辺集合) だけに依存する。
  --   このマッチングパターンも両側の頂点が相異なるため、台集合だけに依存する。
  --   両者の不変性と台集合上の証拠を元の G へ移す補題を証明すれば、
  --   9 種類の辺の部分集合 2^9 = 512 通りの検査に帰着できる。
  decide  -- TODO: 上記の帰着と証拠の移送を実装する。現在は証明スケッチ。

-- ---------------------------------------------------------------
-- 系: Hall 違反例の確認 (n=3, Hall 不成立 → matching 不存在)
-- ---------------------------------------------------------------
-- 「a₁ → {b₁}, a₂ → {b₁}, a₃ → {b₃}」のグラフは Hall 違反で
-- 完全マッチング不存在、を例として確認する補題。

lemma hall_3_violator_no_matching :
    let G : Multiset (Fin 3 × Fin 3)
          := ⟦(0, 0), (1, 0), (2, 2)⟧
    in
    ¬ (G matches
         ($b1, $g1) ::
         ($b2 & !#b1, $g2 & !#g1) ::
         ($b3 & !#b1 & !#b2, $g3 & !#g1 & !#g2) ::
         _
       as multiset (Fin 3 × Fin 3))
  := by decide

-- ---------------------------------------------------------------
-- 仕様メモ: 本サンプルが型検査器に要求する機能
-- ---------------------------------------------------------------
-- (a) 否定 value pattern !#e:
--       value pattern の否定版。target が e と等しくないなら match。
--       Ramsey の反対色三角形 (`!#c & $c'`) と同じ仕掛け。
--       探索による判定には decidable_eq を要求し、証明では不等式の証拠を扱う。
-- (b) 連接パターン p₁ & p₂:
--       同じ target に対し両方マッチしたとき成立。
--       ($b₂ & !#b₁) は「b₂ という名前で束縛、ただし b₁ と異なる値」。
-- (c) multiset の bipartite 観察:
--       (Fin n × Fin n) の multiset を辺集合と見て、boys 側 distinct
--       かつ girls 側 distinct な部分多重集合を取り出すパターン。
--       本ファイルは3×3の辺集合を multiset として観察する設計スケッチ。
--       一般形は design/pwl-hall.md の ⤳ で Hall 条件に違反する部分集合を表し、
--       matching_of でマッチングの関数と証拠を取り出す。
--       両方の表現の型・分解・証拠の規則を揃えて実装する。
-- (d) decide tactic:
--       重複を除いた辺集合への帰着を証明した後、512 通りの全数検査を行う。
--
-- 一般形 Hall:
--   overview.md / pwl-hall.md の中心例である。
--   Hall 条件は近傍を含む部分集合の組についての否定パターンで表し、
--   ⤳ / matching_of による定式化、一般の存在証明、matcher の正しさを実装・証明する。

Adapted from Mathlib v4.31.0, LinearAlgebra/Matrix/Determinant/Basic.lean:
the cancellation lemma also allows a rectangular pair of matrices, and the
selection of two inputs with the same output is compared with a pattern.
-/
import DesignExamples.DeterminantProductCommon

namespace DesignExamples.DeterminantProduct

open Equiv Equiv.Perm Finset Function Matrix

variable {I J R : Type*} [DecidableEq I] [Fintype I] [CommRing R]

local notation "ε " σ:arg => ((sign σ : ℤ) : R)

theorem noninjective_cancel {M : Matrix I J R} {N : Matrix J I R} {p : I → J}
    (hp : ¬Injective p) :
    (∑ σ : Perm I, ε σ * ∏ x, M (σ x) (p x) * N (p x) x) = 0 := by
  match h : p as multiset (I → J) with
  | $i → $k :: $j → #k :: _ =>
    have hij : i ≠ j := h.1
    have hpij : p i = p j := h.2.1.trans h.2.2.symm
    exact
      sum_involution (fun σ _ => σ * Equiv.swap i j)
        (fun σ _ => by
          have : (∏ x, M (σ x) (p x)) = ∏ x, M ((σ * Equiv.swap i j) x) (p x) :=
            Fintype.prod_equiv (swap i j) _ _ (by simp [apply_swap_eq_self hpij])
          simp [this, sign_swap hij, -sign_swap', prod_mul_distrib])
        (fun σ _ _ => (not_congr mul_swap_eq_iff).mpr hij) (fun _ _ => mem_univ _) fun σ _ =>
        mul_swap_involutive i j σ
  exhaustive by shared_image_of_not_injective p hp

theorem nonbijective_cancel {M N : Matrix I I R} {p : I → I} (hp : ¬Bijective p) :
    (∑ σ : Perm I, ε σ * ∏ x, M (σ x) (p x) * N (p x) x) = 0 := by
  apply noninjective_cancel
  simpa only [Finite.injective_iff_bijective] using hp

theorem det_product (M N : Matrix I I R) : det (M * N) = det M * det N := by
  classical
  calc
    det (M * N) = ∑ p : I → I, ∑ σ : Perm I, ε σ * ∏ i, M (σ i) (p i) * N (p i) i := by
      simp only [det_apply', Matrix.mul_apply, prod_univ_sum, mul_sum, Fintype.piFinset_univ]
      rw [Finset.sum_comm]
    _ = ∑ p : I → I with Bijective p, ∑ σ : Perm I, ε σ * ∏ i, M (σ i) (p i) * N (p i) i := by
      refine (sum_subset (filter_subset _ _) fun f _ hbij ↦ nonbijective_cancel ?_).symm
      simpa only [mem_filter_univ] using hbij
    _ = ∑ τ : Perm I, ∑ σ : Perm I, ε σ * ∏ i, M (σ i) (τ i) * N (τ i) i :=
      sum_bij (fun p h ↦ Equiv.ofBijective p (mem_filter.1 h).2) (fun _ _ ↦ mem_univ _)
        (fun _ _ _ _ h ↦ by injection h)
        (fun b _ ↦ ⟨b, mem_filter.2 ⟨mem_univ _, b.bijective⟩, coe_fn_injective rfl⟩) fun _ _ ↦ rfl
    _ = ∑ σ : Perm I, ∑ τ : Perm I, (∏ i, N (σ i) i) * ε τ * ∏ j, M (τ j) (σ j) := by
      simp only [mul_comm, mul_left_comm, prod_mul_distrib, mul_assoc]
    _ = ∑ σ : Perm I, ∑ τ : Perm I, (∏ i, N (σ i) i) * (ε σ * ε τ) * ∏ i, M (τ i) i :=
      (sum_congr rfl fun σ _ =>
        Fintype.sum_equiv (Equiv.mulRight σ⁻¹) _ _ fun τ => by
          have : (∏ j, M (τ j) (σ j)) = ∏ j, M ((τ * σ⁻¹) j) j := by
            rw [← (σ⁻¹ : _ ≃ _).prod_comp]
            simp
          have h : ε σ * ε (τ * σ⁻¹) = ε τ :=
            calc
              ε σ * ε (τ * σ⁻¹) = ε (τ * σ⁻¹ * σ) := by
                rw [mul_comm, sign_mul (τ * σ⁻¹)]
                simp only [Int.cast_mul, Units.val_mul]
              _ = ε τ := by simp only [inv_mul_cancel_right]
          simp_rw [Equiv.coe_mulRight, h]
          simp only [this])
    _ = det M * det N := by
      simp only [det_apply', Finset.mul_sum, mul_comm, mul_left_comm, mul_assoc]

end DesignExamples.DeterminantProduct

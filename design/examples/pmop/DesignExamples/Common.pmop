-- 提案言語の完全なソース。記法と依存関係は ../../README.md を参照。
import Mathlib

namespace DesignExamples

inductive Color where
  | red | blue
  deriving DecidableEq, Fintype

def Color.opposite : Color → Color
  | .red => .blue
  | .blue => .red

@[simp] theorem Color.opposite_opposite (c : Color) :
    c.opposite.opposite = c := by
  cases c <;> rfl

theorem Color.eq_opposite_of_ne {a c : Color} (h : a ≠ c) : a = c.opposite := by
  cases a <;> cases c <;> simp_all [Color.opposite]

theorem color_cases (a c : Color) : a = c ∨ a = c.opposite := by
  by_cases h : a = c
  · exact Or.inl h
  · exact Or.inr (Color.eq_opposite_of_ne h)

end DesignExamples

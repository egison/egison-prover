-- パターンの条件をmatcher定義から得て暗黙に保持する機構は未設計であり，ここでは前提とする。
-- 提案言語の完全なソース。記法と依存関係は ../../README.md を参照。
import DesignExamples.Common

namespace DesignExamples.Schur

def graph (c : D → Color) : Finset (Nat × Color) :=
  Finset.univ.image (fun d => (d.val, c d))

theorem mem_graph (c : D → Color) (d : D) : (d.val, c d) ∈ graph c :=
  Finset.mem_image.mpr ⟨d, Finset.mem_univ d, rfl⟩

def Monochromatic (c : D → Color) (x y z : D) : Prop :=
  ∃ col, c x = col ∧ c y = col ∧ c z = col ∧ x.val + y.val = z.val

theorem schur_two (c : D → Color) :
    graph c matches $x → $col :: $y → #col :: #(x+y) → #col :: _
      as set (Nat × Color) := by
  match c as set (D → Color) with
  | #D.one → $col :: _ =>
    match c D.two as value Color with
    | #col =>
      exact ⟨1, col, 1⟩
    | #(col.opposite) =>
      match c D.four as value Color with
      | #(col.opposite) =>
        exact ⟨2, col.opposite, 2⟩
      | #col =>
        match c D.five as value Color with
        | #col =>
          exact ⟨1, col, 4⟩
        | #(col.opposite) =>
          match c D.three as value Color with
          | #(col.opposite) =>
            exact ⟨2, col.opposite, 3⟩
          | #col =>
            exact ⟨1, col, 3⟩
          exhaustive by (by simpa only [Color.opposite_opposite] using
            color_cases (c D.three) col.opposite)
        exhaustive by color_cases (c D.five) col
      exhaustive by (by simpa only [Color.opposite_opposite] using
            color_cases (c D.four) col.opposite)
    exhaustive by color_cases (c D.two) col
  exhaustive by at_key c D.one

def counterexample (x : Fin 4) : Color := if x.val = 0 ∨ x.val = 3 then .red else .blue

theorem schur_four_counterexample :
    ¬ ∃ x y z : Fin 4, counterexample x = counterexample y ∧
      counterexample y = counterexample z ∧ (x.val + 1) + (y.val + 1) = z.val + 1 := by
  decide

theorem pattern_iff_ordinary (c : D → Color) :
    (graph c matches $x → $col :: $y → #col :: #(x+y) → #col :: _
      as set (Nat × Color)) ↔ ∃ x y z, Monochromatic c x y z := by
  constructor
  · intro h
    match graph c as set (Nat × Color) with
    | $x → $col :: $y → #col :: #(x+y) → #col :: _ =>
      obtain ⟨dx, _, hx⟩ := Finset.mem_image.mp ‹(x, col) ∈ graph c›
      obtain ⟨dy, _, hy⟩ := Finset.mem_image.mp ‹(y, col) ∈ graph c›
      obtain ⟨dz, _, hz⟩ := Finset.mem_image.mp ‹(x + y, col) ∈ graph c›
      simp only [Prod.mk.injEq] at hx hy hz
      exact ⟨dx, dy, dz, col, hx.2, hy.2, hz.2, by omega⟩
    exhaustive by h
  · rintro ⟨dx, dy, dz, col, hx, hy, hz, hsum⟩
    exact ⟨dx.val, col, dy.val⟩

end DesignExamples.Schur
